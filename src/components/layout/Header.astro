---
import {
    getPageFromPath,
    getPageUrl,
    type PageId,
} from "../../lib/routes";
import type { SiteLanguage } from "../../i18n/home";

/**
 * Shared responsive header.
 *
 * Features:
 * - Desktop navigation with section links.
 * - Mobile navigation using native HTML disclosure controls.
 * - French/English language switching.
 * - Localized navigation labels.
 *
 * Since the site currently contains only two homepage
 * routes, navigation links point to homepage sections.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = {
    fr: {
        home: "Accueil",
        about: "À propos",
        puppies: "Nos chiots",
        contact: "Nous contacter",
        menu: "Menu",
        navigation: "Navigation principale",
        language: "English",
    },

    en: {
        home: "Home",
        about: "About us",
        puppies: "Our puppies",
        contact: "Contact us",
        menu: "Menu",
        navigation: "Main navigation",
        language: "Français",
    },
};

const t = labels[lang];

/**
 * Navigation configuration shared by desktop and mobile.
 *
 * Links now target dedicated pages instead of homepage
 * section anchors.
 */
const navigation: {
    id: PageId;
    label: string;
    href: string;
}[] = [
    {
        id: "home",
        label: t.home,
        href: getPageUrl("home", lang),
    },
    {
        id: "about",
        label: t.about,
        href: getPageUrl("about", lang),
    },
    {
        id: "puppies",
        label: t.puppies,
        href: getPageUrl("puppies", lang),
    },
];

const homeUrl = getPageUrl("home", lang);
const contactUrl = getPageUrl("contact", lang);

/**
 * Identify the current semantic page so that switching
 * languages preserves the corresponding destination.
 */
const currentPage = getPageFromPath(Astro.url.pathname);

const otherLanguage = lang === "fr" ? "en" : "fr";

const languageUrl = getPageUrl(
    currentPage ?? "home",
    otherLanguage,
);
---

<header
        class="relative z-20 border-b border-ink/10
         bg-cream"
>
    <div
            class="mx-auto flex max-w-7xl items-center
           justify-between gap-4 px-5 py-4 lg:px-8"
    >
        <!-- Business identity links to the localized homepage. -->
        <a
                href={homeUrl}
                class="flex items-center gap-3 font-heading
             text-xl font-extrabold text-teal
             hover:text-ink"
        >
      <span
              class="rounded-xl bg-honey p-2 text-xl"
              aria-hidden="true"
      >
        🐾
      </span>

            <span>Doodles R Us</span>
        </a>

        <!-- Desktop navigation -->
        <nav
                aria-label={t.navigation}
                class="hidden items-center gap-7 lg:flex"
        >
            {
                navigation.map((item) => (
                        <a
                                href={item.href}
                                class="font-semibold text-ink transition-colors
                   hover:text-teal"
                        >
                            {item.label}
                        </a>
                ))
            }

            <a
                    href={contactUrl}
                    class="rounded-full bg-teal px-6 py-3
               font-bold text-white transition-colors
               hover:bg-ink"
            >
                {t.contact}
            </a>

            <a
                    href={languageUrl}
                    lang={otherLanguage}
                    hreflang={otherLanguage}
                    class="rounded-full border border-teal
               px-4 py-2 font-semibold text-teal
               transition-colors hover:bg-sage"
            >
                {t.language}
            </a>
        </nav>

        <!--
          Mobile and tablet navigation.

          <details> gives us an accessible disclosure
          mechanism without introducing a JavaScript framework.
        -->
        <details class="group relative lg:hidden">
            <summary
                    class="flex min-h-11 cursor-pointer list-none
               items-center gap-2 rounded-xl
               border border-teal px-4 py-2
               font-semibold text-teal
               [&::-webkit-details-marker]:hidden"
            >
                <span aria-hidden="true">☰</span>
                {t.menu}
            </summary>

            <nav
                    aria-label={t.navigation}
                    class="absolute top-full right-0 mt-3
               w-[min(20rem,calc(100vw-2rem))]
               rounded-2xl border border-ink/10
               bg-white p-5 shadow-xl"
            >
                <ul class="flex flex-col gap-4">
                    {
                        navigation.map((item) => (
                                <li>
                                    <a
                                            href={item.href}
                                            class="block py-2 font-semibold text-ink
                         hover:text-teal"
                                    >
                                        {item.label}
                                    </a>
                                </li>
                        ))
                    }

                    <li>
                        <a
                                href={contactUrl}
                                class="block rounded-xl bg-teal
                     px-5 py-3 text-center font-bold
                     text-white hover:bg-ink"
                        >
                            {t.contact}
                        </a>
                    </li>

                    <li>
                        <a
                                href={languageUrl}
                                lang={otherLanguage}
                                hreflang={otherLanguage}
                                class="block rounded-xl border border-teal
                     px-5 py-3 text-center
                     font-semibold text-teal"
                        >
                            {t.language}
                        </a>
                    </li>
                </ul>
            </nav>
        </details>
    </div>
</header>