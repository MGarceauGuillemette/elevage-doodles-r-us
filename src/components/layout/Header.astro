---
import { getRelativeLocaleUrl } from "astro:i18n";

/**
 * Shared navigation header.
 *
 * Displays the business name, homepage navigation,
 * and language switcher.
 *
 * Uses Astro's i18n utilities to generate localized URLs.
 */

interface Props {
    lang: "fr" | "en";
}

const { lang } = Astro.props;

// Localized labels displayed in the navigation.
const labels = {
    fr: {
        home: "Accueil",
        language: "English",
        navigation: "Navigation principale",
    },
    en: {
        home: "Home",
        language: "Français",
        navigation: "Main navigation",
    },
};

const t = labels[lang];

// Generate links using Astro's locale configuration.
const homeUrl = getRelativeLocaleUrl(lang, "");

// For now, switching languages returns to the homepage.
// Later, we will preserve the current page when possible.
const otherLang = lang === "fr" ? "en" : "fr";
const otherLangUrl = getRelativeLocaleUrl(otherLang, "");
---

<header class="border-b border-ink/10 bg-cream">
    <div
            class="mx-auto flex max-w-7xl flex-wrap items-center
           justify-between gap-4 px-6 py-5"
    >
        <!-- Business identity -->
        <a
                href={homeUrl}
                class="font-heading text-xl font-extrabold text-teal
             hover:text-ink"
        >
            Doodles R Us 🐾
        </a>

        <!--
          Navigation remains simple until the other pages exist.
          Flex-wrap keeps it usable on narrow screens without
          requiring JavaScript.
        -->
        <nav aria-label={t.navigation}>
            <ul class="flex flex-wrap items-center gap-5">
                <li>
                    <a
                            href={homeUrl}
                            aria-current="page"
                            class="font-semibold text-ink hover:text-teal"
                    >
                        {t.home}
                    </a>
                </li>

                <li>
                    <!-- Language switcher -->
                    <a
                            href={otherLangUrl}
                            lang={otherLang}
                            hreflang={otherLang}
                            class="rounded-full border border-teal px-4 py-2
                   text-sm font-semibold text-teal
                   transition-colors hover:bg-sage"
                    >
                        {t.language}
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>