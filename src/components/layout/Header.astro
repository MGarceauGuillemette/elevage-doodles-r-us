---
import type { SiteLanguage } from "../../i18n/home";

import {
    getPageFromPath,
    getPageUrl,
    type PageId,
} from "../../lib/routes";

/**
 * Shared rustic website header.
 *
 * Responsibilities:
 * - Display the official business logo.
 * - Provide localized desktop and mobile navigation.
 * - Preserve the current page when switching languages.
 * - Support keyboard and screen-reader navigation.
 *
 * The mobile menu uses native HTML disclosure controls,
 * so it does not require client-side JavaScript.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = {
    fr: {
        home: "Accueil",
        about: "À propos",
        puppies: "Nos chiots",
        contact: "Nous contacter",
        menu: "Menu",
        navigation: "Navigation principale",
        language: "English",
        brandSubtitle: "Élevage familial",
    },

    en: {
        home: "Home",
        about: "About us",
        puppies: "Our puppies",
        contact: "Contact us",
        menu: "Menu",
        navigation: "Main navigation",
        language: "Français",
        brandSubtitle: "Family breeder",
    },
};

const t = labels[lang];

const homeUrl = getPageUrl("home", lang);
const currentPage = getPageFromPath(Astro.url.pathname);

/**
 * Navigation is shared by both menu layouts.
 * URLs come from the central routing module.
 */
const navigation: {
    id: PageId;
    label: string;
    href: string;
}[] = [
    {
        id: "home",
        label: t.home,
        href: homeUrl,
    },
    {
        id: "about",
        label: t.about,
        href: getPageUrl("about", lang),
    },
    {
        id: "puppies",
        label: t.puppies,
        href: getPageUrl("puppies", lang),
    },
];

const contactUrl = getPageUrl("contact", lang);

const otherLanguage = lang === "fr" ? "en" : "fr";

/**
 * Unknown routes fall back to the opposite-language
 * homepage. Known routes preserve the current page.
 */
const languageUrl = getPageUrl(
    currentPage ?? "home",
    otherLanguage,
);
---

<header
        class="relative z-30 border-b border-wood/20
         bg-linen shadow-sm"
>
    <div
            class="mx-auto flex max-w-7xl items-center
           justify-between gap-4 px-4 py-3
           sm:px-6 lg:px-8"
    >
        <!--
          Official logo and business identity.

          The logo has an empty alt attribute because the
          adjacent text already provides the business name.
          This avoids redundant screen-reader announcements.
        -->
        <a
                href={homeUrl}
                class="flex min-w-0 items-center gap-3
             rounded-lg text-espresso
             transition-colors hover:text-wood"
        >
            <img
                    src="/images/branding/doodles-r-us-logo.png"
                    alt=""
                    width="64"
                    height="64"
                    loading="eager"
                    decoding="async"
                    class="h-12 w-12 shrink-0 rounded-full
               object-contain sm:h-16 sm:w-16"
            />

            <span class="flex min-w-0 flex-col">
        <span
                class="font-heading text-lg font-bold
                 leading-tight sm:text-xl"
        >
          Doodles R Us
        </span>

        <span
                class="text-xs font-semibold tracking-wide
                 text-muted sm:text-sm"
        >
          {t.brandSubtitle}
        </span>
      </span>
        </a>

        <!-- Desktop navigation -->
        <nav
                aria-label={t.navigation}
                class="hidden items-center gap-5 lg:flex xl:gap-7"
        >
            {
                navigation.map((item) => (
                        <a
                                href={item.href}
                                aria-current={
                                    currentPage === item.id ? "page" : undefined
                                }
                                class:list={[
                                    "border-b-2 py-2 font-bold transition-colors",
                                    "hover:border-wood hover:text-wood",
                                    currentPage === item.id
                                        ? "border-wood text-wood"
                                        : "border-transparent text-espresso",
                                ]}
                        >
                            {item.label}
                        </a>
                ))
            }

            <a
                    href={contactUrl}
                    aria-current={
                        currentPage === "contact" ? "page" : undefined
                    }
                    class="rounded-xl border border-wood/40
               bg-wood px-5 py-3 font-bold text-white
               shadow-sm transition-colors hover:bg-espresso"
            >
                {t.contact}
            </a>

            <a
                    href={languageUrl}
                    lang={otherLanguage}
                    hreflang={otherLanguage}
                    class="rounded-lg border border-wood/30
               bg-kraft/50 px-3 py-2 text-sm
               font-bold text-espresso
               transition-colors hover:bg-kraft"
            >
                {t.language}
            </a>
        </nav>

        <!--
          Responsive mobile/tablet menu.

          Native <details> supports Enter/Space activation
          and exposes the disclosure state to assistive tools.
        -->
        <details class="group relative lg:hidden">
            <summary
                    class="flex min-h-11 cursor-pointer list-none
               items-center gap-2 rounded-xl
               border border-wood/40 bg-kraft/50
               px-4 py-2 font-bold text-espresso
               transition-colors hover:bg-kraft
               [&::-webkit-details-marker]:hidden"
            >
                <span aria-hidden="true">☰</span>
                {t.menu}
            </summary>

            <nav
                    aria-label={t.navigation}
                    class="absolute top-full right-0 mt-3
               w-[min(20rem,calc(100vw-2rem))]
               rounded-2xl border border-wood/30
               bg-linen p-5 shadow-xl"
            >
                <ul class="flex flex-col gap-2">
                    {
                        navigation.map((item) => (
                                <li>
                                    <a
                                            href={item.href}
                                            aria-current={
                                                currentPage === item.id
                                                    ? "page"
                                                    : undefined
                                            }
                                            class="block rounded-lg px-3 py-3
                         font-bold text-espresso
                         transition-colors hover:bg-kraft"
                                    >
                                        {item.label}
                                    </a>
                                </li>
                        ))
                    }

                    <li>
                        <a
                                href={contactUrl}
                                aria-current={
                                    currentPage === "contact"
                                        ? "page"
                                        : undefined
                                }
                                class="mt-2 block rounded-xl bg-wood
                     px-5 py-3 text-center font-bold
                     text-white hover:bg-espresso"
                        >
                            {t.contact}
                        </a>
                    </li>

                    <li>
                        <a
                                href={languageUrl}
                                lang={otherLanguage}
                                hreflang={otherLanguage}
                                class="mt-2 block rounded-xl
                     border border-wood/40
                     px-5 py-3 text-center
                     font-bold text-wood hover:bg-kraft"
                        >
                            {t.language}
                        </a>
                    </li>
                </ul>
            </nav>
        </details>
    </div>
</header>