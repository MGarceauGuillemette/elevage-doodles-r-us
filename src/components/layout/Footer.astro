---
import type { SiteLanguage } from "../../i18n/home";

import { business } from "../../data/business";

import { getPageUrl } from "../../lib/routes";

import {
    createEmailUrl,
    createPhoneUrl,
    isFacebookUrl,
} from "../../lib/contact";

/**
 * Shared rustic website footer.
 *
 * Responsibilities:
 * - Display localized business information.
 * - Provide navigation to all main pages.
 * - Render only verified contact methods.
 * - Keep the business identity visually consistent.
 *
 * The footer deliberately avoids publishing a private
 * residential address.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = {
    fr: {
        tagline: "Élevage familial de Goldendoodles",
        navigation: "Navigation",
        contact: "Nous joindre",
        home: "Accueil",
        about: "À propos",
        puppies: "Nos chiots",
        contactPage: "Contact",
        rights: "Tous droits réservés.",
        facebook: "Facebook",
    },

    en: {
        tagline: "Family Goldendoodle Breeder",
        navigation: "Navigation",
        contact: "Get in touch",
        home: "Home",
        about: "About us",
        puppies: "Our puppies",
        contactPage: "Contact",
        rights: "All rights reserved.",
        facebook: "Facebook",
    },
} as const;

const t = labels[lang];

const navigation = [
    {
        label: t.home,
        href: getPageUrl("home", lang),
    },
    {
        label: t.about,
        href: getPageUrl("about", lang),
    },
    {
        label: t.puppies,
        href: getPageUrl("puppies", lang),
    },
    {
        label: t.contactPage,
        href: getPageUrl("contact", lang),
    },
];

/**
 * Only expose contact destinations configured through
 * Pages CMS and validated by our data layer.
 */
const { email, phone, facebookUrl } = business.contact;

const safeFacebookUrl =
    facebookUrl && isFacebookUrl(facebookUrl)
        ? facebookUrl
        : null;

const year = new Date().getFullYear();
---

<footer
        class="mt-auto border-t-4 border-kraft
         bg-wood px-5 py-14 text-linen sm:px-6"
>
    <div class="mx-auto max-w-7xl">
        <div
                class="grid gap-12
             md:grid-cols-3 md:gap-8"
        >
            <!-- Business identity -->
            <div>
                <a
                        href={getPageUrl("home", lang)}
                        class="inline-flex items-center gap-3
                 rounded-lg font-heading text-2xl
                 font-bold text-linen
                 hover:text-honey"
                >
                    Doodles R Us
                </a>

                <p class="mt-4 text-sm text-linen/90">
                    {t.tagline}
                </p>

                <p class="mt-3 text-sm text-linen/90">
                    Saint-Colomban, Québec
                </p>

                <div
                        class="mt-5 flex gap-3 text-xl text-honey"
                        aria-hidden="true"
                >
                    <span>♡</span>
                    <span>✦</span>
                    <span>♡</span>
                </div>
            </div>

            <!-- Localized navigation -->
            <nav aria-label={t.navigation}>
                <h2
                        class="font-heading text-xl
                 font-bold text-linen"
                >
                    {t.navigation}
                </h2>

                <ul class="mt-5 space-y-3">
                    {
                        navigation.map((item) => (
                                <li>
                                    <a
                                            href={item.href}
                                            class="inline-block rounded-sm
                         text-linen/90 transition-colors
                         hover:text-honey"
                                    >
                                        {item.label}
                                    </a>
                                </li>
                        ))
                    }
                </ul>
            </nav>

            <!--
              Contact information is optional.
              The dedicated Contact page remains available
              even when no direct contact method is configured.
            -->
            <div>
                <h2
                        class="font-heading text-xl
                 font-bold text-linen"
                >
                    {t.contact}
                </h2>

                <ul class="mt-5 space-y-3">
                    {email && (
                            <li>
                                <a
                                        href={createEmailUrl(email)}
                                        class="break-all text-linen/90
                       hover:text-honey"
                                >
                                    {email}
                                </a>
                            </li>
                    )}

                    {phone && (
                            <li>
                                <a
                                        href={createPhoneUrl(phone)}
                                        class="text-linen/90 hover:text-honey"
                                >
                                    {phone}
                                </a>
                            </li>
                    )}

                    {safeFacebookUrl && (
                            <li>
                                <a
                                        href={safeFacebookUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-linen/90 hover:text-honey"
                                >
                                    {t.facebook}
                                    <span aria-hidden="true"> ↗</span>
                                </a>
                            </li>
                    )}

                    <li>
                        <a
                                href={getPageUrl("contact", lang)}
                                class="inline-block text-honey
                     underline underline-offset-4
                     hover:text-linen"
                        >
                            {t.contactPage}
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Copyright and subtle visual divider -->
        <div
                class="mt-12 border-t border-linen/25
             pt-6 text-center"
        >
            <p class="text-sm text-linen/80">
                © {year} Doodles R Us.
                {t.rights}
            </p>
        </div>
    </div>
</footer>