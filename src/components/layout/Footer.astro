---
/**
    * Shared footer for both language versions.
    *
    * Contains general business information and a copyright
    * notice. Contact details will be added once confirmed
    * with the business owner.
    */

interface Props {
    lang: "fr" | "en";
}

const { lang } = Astro.props;

// Localized footer content.
const content = {
    fr: {
        description: "Élevage familial de Goldendoodles",
        location: "Saint-Colomban, Québec",
        rights: "Tous droits réservés.",
    },
    en: {
        description: "Family Goldendoodle Breeder",
        location: "Saint-Colomban, Québec",
        rights: "All rights reserved.",
    },
};

const t = content[lang];
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-teal px-6 py-12 text-white">
    <div class="mx-auto max-w-7xl">
        <div class="flex flex-col justify-between gap-8 sm:flex-row">
            <div>
                <p class="font-heading text-2xl font-extrabold">
                    Doodles R Us 🐾
                </p>

                <p class="mt-3 text-sm text-white/80">
                    {t.description}
                </p>
            </div>

            <div class="sm:text-right">
                <p class="text-sm text-white/80">
                    📍 {t.location}
                </p>
            </div>
        </div>

        <div class="mt-10 border-t border-white/20 pt-6">
            <p class="text-center text-sm text-white/70">
                © {year} Doodles R Us. {t.rights}
            </p>
        </div>
    </div>
</footer>