---
import { heroImage } from "../../data/siteMedia";
import type { SiteLanguage } from "../../i18n/home";

/**
 * Rustic hero photograph component.
 *
 * Uses layered paper-like surfaces and subtle rotation
 * to create a handmade family-album appearance.
 *
 * The image itself remains controlled through siteMedia.
 * If no approved photograph is configured, the component
 * displays a localized placeholder.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;

const labels = {
    fr: {
        placeholder: "Nos Goldendoodles en images, bientôt!",
        caption: "De beaux moments à quatre pattes",
    },
    en: {
        placeholder: "Photos of our Goldendoodles coming soon!",
        caption: "Beautiful moments with our four-legged friends",
    },
};

const t = labels[lang];
---

<div class="relative mx-auto w-full max-w-lg px-4 py-8">
    <!-- Soft background accents inspired by natural paper. -->
    <div
            class="absolute top-3 right-0 h-24 w-24
           rounded-full bg-sage/60 blur-xl"
            aria-hidden="true"
    ></div>

    <div
            class="absolute bottom-4 left-0 h-28 w-28
           rounded-full bg-rose/40 blur-xl"
            aria-hidden="true"
    ></div>

    <!--
      The outer layer mimics the paper backing of a framed
      family photograph. Rotation is deliberately subtle.
    -->
    <div
            class="relative rotate-[-2deg] rounded-sm
           border border-wood/25 bg-kraft p-3
           shadow-rustic sm:p-4"
    >
        <div
                class="border border-wood/20
             bg-linen p-2 sm:p-3"
        >
            <!-- Fixed aspect ratio avoids layout shifts. -->
            <div
                    class="relative aspect-[4/5] overflow-hidden
               bg-peach"
            >
                {
                    heroImage.src ? (
                            <img
                                    src={heroImage.src}
                                    alt={heroImage.alt[lang]}
                                    width="800"
                                    height="1000"
                                    fetchpriority="high"
                                    decoding="async"
                                    class="h-full w-full object-cover"
                            />
                    ) : (
                            <div
                                    class="flex h-full flex-col items-center
                     justify-center gap-5 p-6 text-center"
                            >
              <span
                      aria-hidden="true"
                      class="text-7xl sm:text-9xl"
              >
                🐶
              </span>

                                <p class="max-w-xs font-heading text-xl
                        font-bold text-espresso"
                                >
                                    {t.placeholder}
                                </p>
                            </div>
                    )
                }
            </div>

            <!--
              Decorative photo caption.
              Text remains horizontal for readability.
            -->
            <div class="px-2 py-5 text-center">
                <p
                        class="font-heading text-lg font-bold
                 italic text-wood sm:text-xl"
                >
                    {t.caption}
                </p>

                <div
                        class="mt-2 flex justify-center gap-3
                 text-rose"
                        aria-hidden="true"
                >
                    <span>♡</span>
                    <span>✦</span>
                    <span>♡</span>
                </div>
            </div>
        </div>
    </div>
</div>