---
import puppyData from "../../data/puppies.json";
import type { Puppy } from "../../types/puppy";
import type { SiteLanguage } from "../../i18n/home";

import PuppyCard from "../ui/PuppyCard.astro";

/**
 * Homepage preview of the breeder's puppy listings.
 *
 * For now, records are loaded from a local JSON file.
 * In a later milestone, Pages CMS will manage that file
 * without requiring the owner to edit source code.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;

// Keep our data constrained by the shared Puppy interface.
const puppies: Puppy[] = puppyData;

const labels = {
    fr: {
        eyebrow: "Nos compagnons à quatre pattes",
        heading: "Nos chiots Goldendoodles",
        emptyTitle: "Informations à venir",
        emptyDescription:
            "Les renseignements sur nos chiots et nos " +
            "prochaines portées seront publiés ici.",
    },
    en: {
        eyebrow: "Our four-legged companions",
        heading: "Our Goldendoodle puppies",
        emptyTitle: "Information coming soon",
        emptyDescription:
            "Details about our puppies and upcoming " +
            "litters will be published here.",
    },
};

const t = labels[lang];
---

<section
        id="chiots"
        aria-labelledby="puppies-heading"
        class="px-6 py-20"
>
    <div class="mx-auto max-w-7xl">
        <div class="text-center">
            <p class="font-bold text-teal">
                {t.eyebrow}
            </p>

            <h2
                    id="puppies-heading"
                    class="mt-4 font-heading text-4xl
               font-extrabold text-ink sm:text-5xl"
            >
                {t.heading}
            </h2>
        </div>

        {
            puppies.length > 0 ? (
                    <div
                            class="mt-12 grid gap-8 sm:grid-cols-2
                 lg:grid-cols-3"
                    >
                        {puppies.map((puppy) => (
                                <PuppyCard puppy={puppy} lang={lang} />
                        ))}
                    </div>
            ) : (
                    <div
                            class="mx-auto mt-12 max-w-xl rounded-3xl
                 bg-sage p-10 text-center"
                    >
          <span class="text-6xl" aria-hidden="true">
            🐾
          </span>

                        <h3 class="mt-5 text-xl font-bold text-ink">
                            {t.emptyTitle}
                        </h3>

                        <p class="mt-4 leading-relaxed text-ink">
                            {t.emptyDescription}
                        </p>
                    </div>
            )
        }
    </div>
</section>