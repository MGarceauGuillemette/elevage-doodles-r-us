---
import {
    homeContent,
    type SiteLanguage,
} from "../../i18n/home";
import PuppyPreview from "./PuppyPreview.astro"
import ContactSection from "./ContactSection.astro";
import Button from "../ui/Button.astro";
import HeroImage from "./HeroImage.astro";

/**
 * Shared, responsive homepage.
 *
 * This component is reused by both localized routes.
 * It receives the active language and displays the
 * corresponding content without duplicating markup.
 *
 * The hero image area is temporary. A real breeder photo
 * will replace it once an approved image is available.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;
const t = homeContent[lang];
---

<main id="main-content">
    <!--
      HERO SECTION

      Introduces the business and directs visitors toward
      puppy availability and contact information.

      The image is managed independently from the hero copy,
      allowing us to add real photographs without changing
      the page's layout.
    -->
    <section
            class="relative overflow-hidden px-6 py-16
         sm:py-20 lg:py-28"
    >
        <div
                class="mx-auto grid max-w-7xl items-center
           gap-14 lg:grid-cols-2 lg:gap-20"
        >
            <!-- Primary homepage content -->
            <div class="relative z-10">
                <p
                        class="inline-flex items-center rounded-full
               bg-sage px-5 py-2 text-sm
               font-bold text-ink"
                >
                    🐾 {t.eyebrow}
                </p>

                <h1
                        class="mt-7 max-w-2xl font-heading
               text-4xl leading-[1.12] font-extrabold
               tracking-tight text-ink
               sm:text-5xl lg:text-6xl xl:text-7xl"
                >
                    {t.heading}
                </h1>

                <p
                        class="mt-7 max-w-xl text-lg leading-relaxed
               text-muted sm:text-xl"
                >
                    {t.introduction}
                </p>

                <!--
                  Reusable navigation actions.
                  Both destinations currently exist on the homepage.
                -->
                <div class="mt-9 flex flex-wrap gap-4">
                    <Button href="#chiots">
                        {t.discoverButton}
                    </Button>

                    <Button href="#contact" variant="secondary">
                        {t.contactButton}
                    </Button>
                </div>

                <!-- Location information only; no private address. -->
                <div
                        class="mt-10 flex items-center gap-2
               text-sm font-semibold text-muted"
                >
                    <span aria-hidden="true">📍</span>
                    <span>Saint-Colomban, Québec</span>
                </div>
            </div>

            <!-- Responsive photograph or temporary placeholder -->
            <HeroImage lang={lang} />
        </div>
    </section>

    <!-- ABOUT: Introduces the breeder without unverified claims. -->
    <section
            id="a-propos"
            aria-labelledby="about-heading"
            class="bg-white px-6 py-20"
    >
        <div class="mx-auto max-w-4xl text-center">
            <p class="font-bold text-teal">
                {t.about.eyebrow}
            </p>

            <h2
                    id="about-heading"
                    class="mt-4 font-heading text-4xl font-extrabold
               text-ink sm:text-5xl"
            >
                {t.about.title}
            </h2>

            <p
                    class="mx-auto mt-6 max-w-2xl text-lg
               leading-relaxed text-muted"
            >
                {t.about.description}
            </p>
        </div>
    </section>

    <!-- PUPPIES: Placeholder until real availability data is added. -->
    <!--
        Reusable puppy availability section.
        Puppy records will eventually be managed through Pages CMS.
    -->
    <PuppyPreview lang={lang} />

    <!--
  Shared bilingual contact section.

  Only verified contact information is displayed.
  Missing contact details use a friendly empty state.
-->
    <ContactSection lang={lang} />
</main>