---
import {
    homeContent,
    type SiteLanguage,
} from "../../i18n/home";
import PuppyPreview from "./PuppyPreview.astro"
import ContactSection from "./ContactSection.astro";
import Button from "../ui/Button.astro";
import HeroImage from "./HeroImage.astro";
import { about } from "../../data/about";
import { getPageUrl } from "../../lib/routes";

/**
 * Shared, responsive homepage.
 *
 * This component is reused by both localized routes.
 * It receives the active language and displays the
 * corresponding content without duplicating markup.
 *
 * The hero image area is temporary. A real breeder photo
 * will replace it once an approved image is available.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;
const t = homeContent[lang];
---

<main id="main-content">
    <!--
      RUSTIC HOMEPAGE HERO

      The two-column layout balances readable business
      information with an approved breeder photograph.

      Decorative shapes are intentionally subtle so the
      design remains usable and accessible on small screens.
    -->
    <section
            class="relative overflow-hidden bg-cream
         px-5 py-14 sm:px-6 sm:py-20 lg:py-24"
    >
        <!-- Decorative countryside-inspired accents -->
        <div
                class="pointer-events-none absolute -top-24
           -left-24 h-72 w-72 rounded-full
           bg-kraft/40 blur-3xl"
                aria-hidden="true"
        ></div>

        <div
                class="relative mx-auto grid max-w-7xl
           items-center gap-12 lg:grid-cols-2
           lg:gap-16"
        >
            <!-- Main business introduction -->
            <div class="text-center lg:text-left">
                <!-- Kraft paper-style section label -->
                <div
                        class="inline-flex items-center gap-2
               rounded-lg border border-wood/20
               bg-kraft px-5 py-2.5
               shadow-sm"
                >
                    <span aria-hidden="true">♡</span>

                    <p class="text-sm font-bold tracking-wide
                  text-wood"
                    >
                        {t.eyebrow}
                    </p>
                </div>

                <h1
                        class="mt-8 max-w-2xl font-heading
               text-4xl leading-[1.15]
               font-bold tracking-tight
               text-espresso sm:text-5xl
               xl:text-6xl"
                >
                    {t.heading}
                </h1>

                <!-- Natural divider inspired by the owner's art -->
                <div
                        class="mx-auto mt-6 flex items-center
               justify-center gap-4 text-wood/70
               lg:mx-0 lg:justify-start"
                        aria-hidden="true"
                >
                    <span class="h-px w-14 bg-wood/40"></span>
                    <span>✦</span>
                    <span class="h-px w-14 bg-wood/40"></span>
                </div>

                <p
                        class="mx-auto mt-7 max-w-xl
               text-lg leading-relaxed
               text-muted sm:text-xl lg:mx-0"
                >
                    {t.introduction}
                </p>

                <!--
                  Shared button components keep both languages
                  consistent and preserve working section anchors.
                -->
                <div
                        class="mt-9 flex flex-wrap
               justify-center gap-4 lg:justify-start"
                >
                    <Button
                            href="#chiots"
                            class="rounded-xl bg-wood
                 text-white hover:bg-espresso"
                    >
                        {t.discoverButton}
                    </Button>

                    <Button
                            href="#contact"
                            variant="secondary"
                            class="rounded-xl border-wood
                 text-wood hover:bg-kraft"
                    >
                        {t.contactButton}
                    </Button>
                </div>

                <!-- Public location, without a residential address -->
                <div
                        class="mt-9 flex items-center justify-center
               gap-2 text-sm font-bold
               text-muted lg:justify-start"
                >
                    <span aria-hidden="true">⌖</span>
                    <span>Saint-Colomban, Québec</span>
                </div>
            </div>

            <!-- Framed photograph shared by both languages -->
            <HeroImage lang={lang} />
        </div>
    </section>


    <!--
      ABOUT SECTION

      Introduces the breeder using CMS-managed bilingual
      content. The paper-style panel reflects the owner's
      handmade countryside visual identity.

      The link leads to the dedicated localized About page.
    -->
    <section
            id="a-propos"
            aria-labelledby="home-about-heading"
            class="relative scroll-mt-24 overflow-hidden
         bg-linen px-5 py-20 sm:px-6 lg:py-28"
    >
        <!-- Decorative accents have no semantic meaning. -->
        <div
                class="pointer-events-none absolute -top-16
           right-0 h-64 w-64 rounded-full
           bg-kraft/40 blur-3xl"
                aria-hidden="true"
        ></div>

        <div class="relative mx-auto max-w-5xl">
            <!-- Outer kraft-paper frame -->
            <div
                    class="border border-wood/25 bg-kraft
             p-3 shadow-rustic sm:p-5"
            >
                <!-- Inner story panel -->
                <div
                        class="border border-wood/20 bg-cream
               px-6 py-12 text-center
               sm:px-12 sm:py-16"
                >
                    <p
                            class="font-bold tracking-wide text-wood"
                    >
                        {t.about.eyebrow}
                    </p>

                    <h2
                            id="home-about-heading"
                            class="mt-5 font-heading text-4xl
                 font-bold text-espresso
                 sm:text-5xl"
                    >
                        {t.about.title}
                    </h2>

                    <!-- Handmade ornamental divider -->
                    <div
                            class="my-6 flex items-center
                 justify-center gap-4 text-rose"
                            aria-hidden="true"
                    >
                        <span class="h-px w-14 bg-wood/40"></span>
                        <span>♡</span>
                        <span class="h-px w-14 bg-wood/40"></span>
                    </div>

                    <!--
                      Text is validated before rendering.
                      It remains editable through Pages CMS.
                    -->
                    <p
                            class="mx-auto max-w-2xl text-lg
                 leading-relaxed text-muted"
                    >
                        {about[lang].introduction}
                    </p>

                    <div class="mt-9">
                        <Button
                                href={getPageUrl("about", lang)}
                                variant="secondary"
                        >
                            {lang === "fr"
                                ? "Découvrir notre histoire"
                                : "Discover our story"}
                        </Button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PUPPIES: Placeholder until real availability data is added. -->
    <!--
        Reusable puppy availability section.
        Puppy records will eventually be managed through Pages CMS.
    -->
    <PuppyPreview lang={lang} />

    <!--
  Shared bilingual contact section.

  Only verified contact information is displayed.
  Missing contact details use a friendly empty state.
-->
    <ContactSection lang={lang} />
</main>