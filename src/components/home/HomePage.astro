---
import {
    homeContent,
    type SiteLanguage,
} from "../../i18n/home";
import PuppyPreview from "./PuppyPreview.astro"
import ContactSection from "./ContactSection.astro";

/**
 * Shared, responsive homepage.
 *
 * This component is reused by both localized routes.
 * It receives the active language and displays the
 * corresponding content without duplicating markup.
 *
 * The hero image area is temporary. A real breeder photo
 * will replace it once an approved image is available.
 */
interface Props {
    lang: SiteLanguage;
}

const { lang } = Astro.props;
const t = homeContent[lang];
---

<main id="main-content">
    <!-- HERO: Main introduction and primary navigation actions -->
    <section class="overflow-hidden px-6 py-16 lg:py-24">
        <div
                class="mx-auto grid max-w-7xl items-center gap-12
             lg:grid-cols-2 lg:gap-16"
        >
            <div>
                <p
                        class="mb-6 inline-flex rounded-full bg-sage
                 px-5 py-2 text-sm font-bold text-ink"
                >
                    🐾 {t.eyebrow}
                </p>

                <h1
                        class="max-w-2xl font-heading text-5xl
                 leading-tight font-extrabold tracking-tight
                 text-ink sm:text-6xl lg:text-7xl"
                >
                    {t.heading}
                </h1>

                <p
                        class="mt-7 max-w-xl text-lg leading-relaxed
                 text-muted sm:text-xl"
                >
                    {t.introduction}
                </p>

                <!-- Both buttons target real homepage sections. -->
                <div class="mt-9 flex flex-wrap gap-4">
                    <a
                            href="#chiots"
                            class="inline-flex min-h-12 items-center justify-center
                   rounded-full bg-teal px-7 py-3 font-bold
                   text-white transition-colors hover:bg-ink"
                    >
                        {t.discoverButton}
                    </a>

                    <a
                            href="#contact"
                            class="inline-flex min-h-12 items-center justify-center
                   rounded-full border-2 border-teal px-7 py-3
                   font-bold text-teal transition-colors
                   hover:bg-sage"
                    >
                        {t.contactButton}
                    </a>
                </div>
            </div>

            <!--
              Temporary visual placeholder.
              No unrelated breeder photographs are used.
            -->
            <div
                    class="relative flex min-h-80 items-center justify-center
               rounded-[3rem] bg-peach p-8 sm:min-h-120"
            >
                <div
                        class="absolute top-6 right-6 h-20 w-20
                 rounded-full bg-honey/70"
                        aria-hidden="true"
                ></div>

                <div
                        class="absolute bottom-8 left-6 h-28 w-28
                 rounded-full bg-sage/70"
                        aria-hidden="true"
                ></div>

                <div class="relative z-10 max-w-sm text-center">
          <span
                  class="block text-8xl sm:text-9xl"
                  aria-hidden="true"
          >
            🐶
          </span>

                    <p class="mt-5 text-lg font-bold text-ink">
                        {t.photoPlaceholder}
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT: Introduces the breeder without unverified claims. -->
    <section
            id="a-propos"
            aria-labelledby="about-heading"
            class="bg-white px-6 py-20"
    >
        <div class="mx-auto max-w-4xl text-center">
            <p class="font-bold text-teal">
                {t.about.eyebrow}
            </p>

            <h2
                    id="about-heading"
                    class="mt-4 font-heading text-4xl font-extrabold
               text-ink sm:text-5xl"
            >
                {t.about.title}
            </h2>

            <p
                    class="mx-auto mt-6 max-w-2xl text-lg
               leading-relaxed text-muted"
            >
                {t.about.description}
            </p>
        </div>
    </section>

    <!-- PUPPIES: Placeholder until real availability data is added. -->
    <!--
        Reusable puppy availability section.
        Puppy records will eventually be managed through Pages CMS.
    -->
    <PuppyPreview lang={lang} />

    <!--
  Shared bilingual contact section.

  Only verified contact information is displayed.
  Missing contact details use a friendly empty state.
-->
    <ContactSection lang={lang} />
</main>