---
/**
    * Reusable rustic introduction for secondary pages.
    *
    * Used by About, Puppies and Contact pages.
    *
    * Receives translated content as props, keeping the
    * presentation independent of localization and CMS data.
    */
interface Props {
    eyebrow: string;
    heading: string;
    paragraphs?: string[];
}

const {
    eyebrow,
    heading,
    paragraphs = [],
} = Astro.props;
---

<section
        aria-labelledby="page-intro-heading"
        class="relative overflow-hidden bg-cream
         px-5 py-16 sm:px-6 sm:py-20 lg:py-24"
>
    <!-- Subtle decorative background accent -->
    <div
            class="pointer-events-none absolute -top-20
           -right-20 h-64 w-64 rounded-full
           bg-sage/25 blur-3xl"
            aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-4xl">
        <!-- Rustic paper backing -->
        <div
                class="border border-wood/25 bg-kraft
             p-3 shadow-rustic sm:p-4"
        >
            <div
                    class="border border-wood/20 bg-linen
               px-6 py-12 text-center sm:px-12"
            >
                <p
                        class="font-bold tracking-wide text-wood"
                >
                    {eyebrow}
                </p>

                <h1
                        id="page-intro-heading"
                        class="mt-6 font-heading text-4xl
                 font-bold text-espresso
                 sm:text-5xl lg:text-6xl"
                >
                    {heading}
                </h1>

                <div
                        class="my-6 flex items-center
                 justify-center gap-4 text-rose"
                        aria-hidden="true"
                >
                    <span class="h-px w-14 bg-wood/40"></span>
                    <span>✦</span>
                    <span class="h-px w-14 bg-wood/40"></span>
                </div>

                <!--
                  Each paragraph remains separate for readability.
                  Content may originate from Pages CMS.
                -->
                {
                    paragraphs.map((paragraph) => (
                            <p
                                    class="mx-auto mt-5 max-w-2xl
                     whitespace-pre-line text-lg
                     leading-relaxed text-muted"
                            >
                                {paragraph}
                            </p>
                    ))
                }
            </div>
        </div>
    </div>
</section>