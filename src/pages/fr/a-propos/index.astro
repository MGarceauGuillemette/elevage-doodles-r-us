---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageIntro from "../../../components/ui/PageIntro.astro";
import { pagesContent } from "../../../i18n/pages";
import { about } from "../../../data/about";

/**
 * French About page.
 *
 * Displays owner-reviewable placeholder copy until
 * the breeder provides their complete business story.
 */
const content = pagesContent.fr.about;
---

<BaseLayout
        title={content.title}
        description={content.description}
        lang="fr"
>
    <main id="main-content">
        <PageIntro
                eyebrow={content.eyebrow}
                heading={content.heading}
                paragraphs={[
                    about.fr.introduction,
                    about.fr.story,
                ]}
        />
    </main>
</BaseLayout>