---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Élevage familial de Goldendoodles"
	description="Découvrez Doodles R Us, un élevage familial de Goldendoodles situé à Saint-Colomban dans les Laurentides."
	lang="fr"
>
	<main class="flex min-h-screen items-center justify-center px-6 py-12">

		<section class="mx-auto max-w-3xl text-center">

			<div
				class="mb-8 inline-flex items-center rounded-full bg-sage px-5 py-2"
			>
        <span class="text-sm font-semibold text-ink">
          🐾 Saint-Colomban, Québec
        </span>
			</div>

			<h1
				class="font-heading text-5xl font-extrabold tracking-tight text-ink md:text-7xl"
			>
				Bienvenue chez
				<span class="text-teal">Doodles R Us!</span>
			</h1>

			<p
				class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-muted md:text-xl"
			>
				Un élevage familial de Goldendoodles où chaque
				petite patte apporte de grands bonheurs.
			</p>

			<div class="mt-10 flex flex-wrap justify-center gap-4">
				<a
					href="#chiots"
					class="rounded-full bg-teal px-8 py-4 font-semibold text-white transition-colors hover:bg-ink"
				>
					Découvrir nos chiots
				</a>

				<a
					href="#contact"
					class="rounded-full border-2 border-teal px-8 py-4 font-semibold text-teal transition-colors hover:bg-sage"
				>
					Nous contacter
				</a>
			</div>

			<div
				class="mx-auto mt-16 grid max-w-xl gap-4 sm:grid-cols-3"
			>
				<div class="rounded-2xl bg-peach p-6">
					<p class="text-3xl">❤️</p>
					<p class="mt-3 font-semibold">Familial</p>
				</div>

				<div class="rounded-2xl bg-honey p-6">
					<p class="text-3xl">🐶</p>
					<p class="mt-3 font-semibold">Goldendoodles</p>
				</div>

				<div class="rounded-2xl bg-sage p-6">
					<p class="text-3xl">🏡</p>
					<p class="mt-3 font-semibold">Québec</p>
				</div>
			</div>

			<!-- Temporary anchor targets.
                 These sections will be built in a later milestone. -->
			<div id="chiots"></div>
			<div id="contact"></div>

		</section>

	</main>
</BaseLayout>