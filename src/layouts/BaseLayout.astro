---
import "../styles/global.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

/**
 * Shared page layout.
 *
 * Responsibilities:
 * - Set the document language and metadata.
 * - Apply global styles.
 * - Render shared navigation and footer.
 * - Provide a consistent structure for page content.
 */

interface Props {
    title: string;
    description: string;
    lang?: "fr" | "en";
}

const {
    title,
    description,
    lang = "fr",
} = Astro.props;
---

<!doctype html>
<html lang={lang === "fr" ? "fr-CA" : "en-CA"}>
<head>
    <meta charset="UTF-8" />

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={description} />

    <title>{title} | Doodles R Us</title>
</head>

<body class="flex min-h-screen flex-col bg-cream text-ink">

<!-- Shared navigation -->
<Header lang={lang} />

<!-- Page-specific content -->
<slot />

<!-- Shared footer -->
<Footer lang={lang} />

</body>
</html>