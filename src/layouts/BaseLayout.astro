---
import "../styles/global.css";

interface Props {
    title: string;
    description: string;
    lang?: "fr" | "en";
}

const {
    title,
    description,
    lang = "fr",
} = Astro.props;
---

<!doctype html>
<html lang={lang === "fr" ? "fr-CA" : "en-CA"}>
<head>
    <meta charset="UTF-8" />
    <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />

    <title>{title} | Doodles R Us</title>
</head>

<body class="min-h-screen bg-cream text-ink">
<slot />
</body>
</html>